# Database
DATABASE_URL=postgresql://postgres:your_password@your-host:5432/your_db

# Security
SECRET_KEY=dev-secret-key
JWT_SECRET=change_me
FLASK_DEBUG=false
AUTO_SEED_DEMO_ACCOUNTS=false
DB_WATCHER_ENABLED=true
DB_WATCH_INTERVAL_SECONDS=3

# OTP
OTP_EXPIRES_MINUTES=5
OTP_DEV_BYPASS_SMS=false

# CORS (for Vercel frontend)
FRONTEND_ORIGIN=https://your-frontend.vercel.app
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app,https://www.your-frontend.vercel.app

# Twilio SMS
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
